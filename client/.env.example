# ==============================================================================
# SkillBridge Client Environment Variables Template
# Copy this file to .env and configure for your target backend API.
# Note: Vite only exposes variables prefixed with VITE_ to the browser bundle.
# NEVER store secrets, private tokens, or database credentials here.
# ==============================================================================

# SkillBridge REST API Base URL
VITE_API_URL=http://localhost:5000
