# ==============================================================================
# SkillBridge Server Environment Variables Template
# Copy this file to .env and provide your deployment secrets.
# NEVER commit real credentials, passwords, or production keys into Git.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB instance)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/skillbridge

# JWT Authentication
# In production, use a high-entropy cryptographically random string (e.g., openssl rand -base64 48)
JWT_SECRET=your_super_secret_jwt_key_skillbridge_development
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
# Comma-separated list of allowed frontend origins (e.g., https://skillbridge.example.com,http://localhost:5173,http://127.0.0.1:5173)
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Optional: Authentication rate limit override for production (defaults to 30 requests per 15 min in production)
AUTH_RATE_LIMIT_MAX=30
